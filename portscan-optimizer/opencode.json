{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  "agent": {
    "planner": {
      "mode": "primary",
      "model": "opencode/minimax-m2.5-free",
      "prompt": "{file:./.opencode/agents/planner.md}",
      "temperature": 0.2,
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "task": { "*": "allow" }
      }
    },
    "executor": {
      "description": "Runs ML training experiments and writes metrics",
      "mode": "subagent",
      "model": "opencode/minimax-m2.5-free",
      "prompt": "{file:./.opencode/agents/executor.md}",
      "temperature": 0.1,
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}